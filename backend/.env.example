# Copy this file to backend/.env (or .env at the repo root) and fill it in. Never commit .env.
# Required: ANTHROPIC_API_KEY, MONGODB_URI and one of OPENAI_API_KEY / GROQ_API_KEY.

# Claude: the agent brain. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Whisper speech recognition. Set ONE of these two:
#   OpenAI: https://platform.openai.com/api-keys
#   Groq (faster, hosts Whisper large-v3): https://console.groq.com/keys
OPENAI_API_KEY=
GROQ_API_KEY=

# Optional: natural text-to-speech voices. Without it the browser's built-in voice is used.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional: child voices for the voice picker in Settings. Create a girl and a boy voice with
# Voice Design (elevenlabs.io > Voices > Create a voice > Voice Design), save them, and paste
# their voice ids here. The ElevenLabs free plan can't use library voices through the API, so
# they must be your own voices. Leave empty to offer only the four adult voices.
ELEVENLABS_VOICE_GIRL=
ELEVENLABS_VOICE_BOY=

# MongoDB Atlas connection string (Atlas > your cluster > Connect > Drivers > Python).
# If your password has special characters (@ : / ? # %), URL-encode them.
MONGODB_URI=
MONGODB_DB=echo

# Optional: Voyage AI multilingual text embeddings (Turkish + English sentence matching by meaning).
# Without it Echo matches sentences by spelling similarity. https://dash.voyageai.com
EMBEDDING_API_KEY=

# Where the frontend runs (comma-separated if more than one).
FRONTEND_URL=http://localhost:3000
