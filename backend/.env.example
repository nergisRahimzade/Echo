# Copy this file to backend/.env and fill in every value. Never commit .env.

# Claude: the agent brain. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Whisper speech recognition. Set ONE of these two:
#   OpenAI: https://platform.openai.com/api-keys
#   Groq (faster, hosts Whisper large-v3): https://console.groq.com/keys
OPENAI_API_KEY=
GROQ_API_KEY=

# Text-to-speech voices. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# MongoDB Atlas connection string (Atlas > your cluster > Connect > Drivers > Python).
# If your password has special characters (@ : / ? # %), URL-encode them.
MONGODB_URI=
MONGODB_DB=echo

# Multilingual text embeddings (Turkish + English sentence matching).
EMBEDDING_API_KEY=

# Where the frontend runs (comma-separated if more than one).
FRONTEND_URL=http://localhost:3000
